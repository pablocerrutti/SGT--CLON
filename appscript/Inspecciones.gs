function hojaInspecciones_(){let sh=bd().getSheetByName('Inspecciones');if(!sh){sh=bd().insertSheet('Inspecciones');sh.appendRow(['ID','Elemento ID','Código elemento','Inspector','Fecha','Incidencia','Video URL','Foto/boleta URL','Estado','Activo']);}return sh;}
function obtenerInspecciones(e){try{const id=String(((e&&e.parameter)||{}).id||'').trim(),d=hojaInspecciones_().getDataRange().getDisplayValues();return {ok:true,datos:d.slice(1).filter(f=>f[0]&&(!id||String(f[1])===id)).map(f=>({id:f[0],elementoId:f[1],codigoElemento:f[2],inspector:f[3],fecha:f[4],incidencia:f[5],videoUrl:f[6],documentoUrl:f[7],estado:f[8],activo:f[9]}))};}catch(error){return {ok:false,mensaje:'No fue posible obtener inspecciones: '+error.message};}}
function guardarInspeccion(e){const p=(e&&e.parameter)||{};if(!String(p.elementoId||'').trim())return {ok:false,mensaje:'Seleccione un elemento.'};if(!String(p.incidencia||'').trim())return {ok:false,mensaje:'Describa la incidencia.'};try{hojaInspecciones_().appendRow([generarID('INS'),String(p.elementoId).trim(),String(p.codigoElemento||'').trim(),String(p.inspector||'Inspector').trim(),ahora(),String(p.incidencia).trim(),String(p.videoUrl||''),String(p.documentoUrl||''),String(p.estado||'Registrada'),'SI']);return {ok:true,mensaje:'Inspección registrada.'};}catch(error){return {ok:false,mensaje:'No fue posible guardar la inspección: '+error.message};}}
function subirArchivo(e){const p=(e&&e.parameter)||{};try{if(!p.archivoBase64||!p.nombreArchivo)return {ok:false,mensaje:'Archivo incompleto.'};const nombre=String(p.nombreArchivo).replace(/[\\/:*?"<>|]/g,'_'),blob=Utilities.newBlob(Utilities.base64Decode(p.archivoBase64),String(p.mimeType||'application/octet-stream'),nombre),archivo=carpetaFotos().createFile(blob);return {ok:true,url:archivo.getUrl(),nombre:archivo.getName()};}catch(error){return {ok:false,mensaje:'No fue posible subir el archivo: '+error.message};}}
