function crearAdministradorInicial(nombre, usuario, password) { if (!nombre || !usuario || !password) throw new Error('Indique nombre, usuario y contraseña.'); let sh=bd().getSheetByName('Usuarios'); if (!sh) { sh=bd().insertSheet('Usuarios'); sh.appendRow(['ID','Usuario','Contraseña','Nombre','Rol','Activo','Fecha alta']); } if (sh.getLastRow()>1) throw new Error('Ya existen usuarios. Use la pantalla de Usuarios.'); sh.appendRow([generarID('USR'),String(usuario).trim(),String(password),String(nombre).trim(),'Super Admin','SI',ahora()]); return 'Administrador inicial creado.'; }
